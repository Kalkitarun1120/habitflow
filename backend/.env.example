# =================================================================
# HabitFlow V2 — Environment Configuration Template (.env.example)
# =================================================================

# --- MySQL Database Configuration ---
# If your MySQL password contains special characters (like @, #, %), URL-encode them (e.g. @ -> %40)
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/habitflow
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=habitflow
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# --- JWT Authentication & Security ---
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost:5173

# --- Google OAuth 2.0 / OpenID Connect ---
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- SMS / Phone OTP Verification (Twilio Verify) ---
# Set SMS_PROVIDER to 'twilio' for real SMS delivery or 'console' for local dev
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OTP_DEV_MODE=false

# --- Email Verification & Password Recovery ---
# Set EMAIL_PROVIDER to 'smtp' or 'console'
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=noreply@habitflow.app
EMAILS_FROM_NAME=HabitFlow

# --- OTP Security & Rate Limiting ---
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DEV_MODE=false
